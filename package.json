    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.0",
